🔹 Cypher: Create Nodes & Relationships

Run this directly in Neo4j Browser:

// Movies
MERGE (:Movie {title: "Toy Story"});
MERGE (:Movie {title: "The Matrix"});
MERGE (:Movie {title: "Inception"});

// Genres
MERGE (:Genre {name: "Animation"});
MERGE (:Genre {name: "Comedy"});
MERGE (:Genre {name: "Action"});
MERGE (:Genre {name: "Sci-Fi"});
MERGE (:Genre {name: "Thriller"});

// Actors
MERGE (:Actor {name: "Tom Hanks"});
MERGE (:Actor {name: "Keanu Reeves"});
MERGE (:Actor {name: "Leonardo DiCaprio"});

🔹 Create Relationships
// Toy Story
MATCH (m:Movie {title:"Toy Story"}), (g:Genre {name:"Animation"})
MERGE (m)-[:HAS_GENRE]->(g);

MATCH (m:Movie {title:"Toy Story"}), (g:Genre {name:"Comedy"})
MERGE (m)-[:HAS_GENRE]->(g);

MATCH (a:Actor {name:"Tom Hanks"}), (m:Movie {title:"Toy Story"})
MERGE (a)-[:ACTED_IN]->(m);

// The Matrix
MATCH (m:Movie {title:"The Matrix"}), (g:Genre {name:"Action"})
MERGE (m)-[:HAS_GENRE]->(g);

MATCH (m:Movie {title:"The Matrix"}), (g:Genre {name:"Sci-Fi"})
MERGE (m)-[:HAS_GENRE]->(g);

MATCH (a:Actor {name:"Keanu Reeves"}), (m:Movie {title:"The Matrix"})
MERGE (a)-[:ACTED_IN]->(m);

// Inception
MATCH (m:Movie {title:"Inception"}), (g:Genre {name:"Sci-Fi"})
MERGE (m)-[:HAS_GENRE]->(g);

MATCH (m:Movie {title:"Inception"}), (g:Genre {name:"Thriller"})
MERGE (m)-[:HAS_GENRE]->(g);

MATCH (a:Actor {name:"Leonardo DiCaprio"}), (m:Movie {title:"Inception"})
MERGE (a)-[:ACTED_IN]->(m);

